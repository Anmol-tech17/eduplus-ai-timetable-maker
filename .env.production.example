# ==============================================================================
# EduPlus AI Timetable Maker — Production Environment Template
# Copy to backend/.env (or inject via orchestrator secrets). NEVER commit real secrets.
# ==============================================================================

ENVIRONMENT=production
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Security & JWT (MUST be >= 32 random chars in production, e.g. `openssl rand -hex 32`)
SECRET_KEY=REPLACE_WITH_64_CHAR_CRYPTOGRAPHICALLY_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# Cookie & CSRF Settings (HTTPS required when COOKIE_AUTH_ENABLED=true)
COOKIE_AUTH_ENABLED=true
COOKIE_SECURE=true
COOKIE_SAMESITE=strict
# COOKIE_DOMAIN=timetable.yourcollege.edu

# Disable dev fallbacks and OpenAPI docs in production
ENABLE_DEV_FALLBACKS=false
ENABLE_DOCS=false

# PostgreSQL 18 Connection & Pooling
DATABASE_URL=postgresql+psycopg2://eduplus_user:REPLACE_WITH_DB_PASSWORD@db:5432/eduplus_prod
DB_POOL_SIZE=15
DB_MAX_OVERFLOW=25
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30

# Background CP-SAT Solver Workers
SOLVER_MAX_WORKERS=2

# Explicit HTTPS CORS Origins (NO '*' or 'null' allowed in production)
ALLOWED_ORIGINS=https://timetable.yourcollege.edu

# Observability
LOG_LEVEL=INFO
LOG_FORMAT=json

# AI / LLM Provider ("auto", "gemini", or "mock")
LLM_PROVIDER=auto
# GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY
GEMINI_MODEL=gemini-1.5-flash
