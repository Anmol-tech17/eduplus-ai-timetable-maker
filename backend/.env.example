# Database Settings
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/eduplus_db
TEST_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/eduplus_test_db

# Application Settings
ENVIRONMENT=development
